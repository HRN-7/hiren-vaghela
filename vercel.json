{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":"vite",
  "installCommand":"npm ci",
  "buildCommand":"npm run build",
  "outputDirectory":"dist",
  "rewrites":[{"source":"/((?!assets/|favicon.svg|farm.jpg|firebase-messaging-sw.js).*)","destination":"/index.html"}],
  "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Permissions-Policy","value":"camera=(self), microphone=()"},{"key":"X-Frame-Options","value":"SAMEORIGIN"}]}]
}
