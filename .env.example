# Frontend: set VITE_API_BASE_URL to the deployed Render HTTPS URL + /api.
VITE_API_BASE_URL=http://localhost:8000/api
# Firebase web configuration is public app identification, not an admin secret.
# Restrict allowed auth domains and API-key usage in your Firebase/GCP project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
# Backend only. NEVER prefix these keys with VITE_.
DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
CORS_ORIGINS=http://localhost:4173
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
OSRM_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
PARTNER_DATA_URL=
PARTNER_API_KEY=
MODEL_DIRECTORY=models
ENVIRONMENT=development
# Optional: pause delivery without removing in-app notifications.
PUSH_DELIVERY_ENABLED=true
PUSH_POLL_SECONDS=15

# Crop-location geocoding; use a suitable provider for production traffic.
NOMINATIM_URL=https://nominatim.openstreetmap.org
